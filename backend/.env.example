# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=backend_crypto
DB_USER=root
DB_PASSWORD=your_password_here

# Binance API Keys (opcional - no necesario para datos públicos)
# BINANCE_API_KEY=
# BINANCE_API_SECRET=

# Resend (Email service)
RESEND_API_KEY=re_xxxxxxxxxx
BASE_URL=https://api.criterio.trade

# Trading bot (python -m bot). Paper trading needs none of these.
# BOT_API_TOKEN=            # enables /api/bot/* (header X-Bot-Token)
# BOT_BINANCE_KEY=          # only for broker "demo" or "live"
# BOT_BINANCE_SECRET=
# BOT_ALLOW_LIVE=1          # required to trade real money
# AI desk (python -m bot ai shadow). A model without its key is simply left out.
# OPENAI_API_KEY=           # gpt-6.1-terra (primary by default)
# DEEPSEEK_API_KEY=         # deepseek-flash (shadow)
# ANTHROPIC_API_KEY=        # claude-haiku-5-5 (shadow); also used by ai_explainer.py
